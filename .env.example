# Backend defaults; shell/SSO/Secrets Manager supply runtime secrets.
AWS_REGION=ap-southeast-1
BEDROCK_REGION=us-east-1
# Assistant target: enable only after account access and Lambda IAM are verified.
ASSISTANT_MODEL_ID=anthropic.claude-haiku-4-5
# OCR remains independently configured on its existing model.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AI_ENABLED=false
# Local server sets LOCAL_MODE=true and uses synthetic fixtures, never AWS credentials.
# LINE credentials belong in Secrets Manager; do not put them in Git.
