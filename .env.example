# Backend defaults; shell/SSO/Secrets Manager supply runtime secrets.
AWS_REGION=ap-southeast-1
AI_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AI_ENABLED=false
# Local server sets LOCAL_MODE=true and uses synthetic fixtures, never AWS credentials.
# LINE credentials belong in Secrets Manager; do not put them in Git.
