{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "confidence",
    "reason",
    "detected_platforms",
    "needs_calculation"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "FEE_PIPELINE",
        "NORMAL_CHAT",
        "CLARIFY"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[^\\r\\n]+$"
    },
    "detected_platforms": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 4,
      "items": {
        "type": "string",
        "enum": [
          "SHOPEE",
          "LAZADA",
          "TIKTOK",
          "LINE"
        ]
      }
    },
    "needs_calculation": {
      "type": "boolean"
    }
  }
}
